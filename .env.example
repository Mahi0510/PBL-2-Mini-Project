# Copy to ".env" and fill in real values. Never commit ".env".

# --- Branding (shown to candidates and in emails)
COMPANY_NAME=Your Company

# --- HR login (REQUIRED - choose a strong password; if blank a random one is printed at start-up)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Email (Gmail: turn on 2-Step Verification, then create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=Your Company HR Team

# --- Security / privacy
COOKIE_SECURE=false        # set true when the site is served over HTTPS
TRUST_PROXY=false          # set true only behind your own reverse proxy (Caddy/nginx)
SESSION_HOURS=8
RETENTION_DAYS=365         # candidate data older than this is deleted automatically (0 = keep forever)

# --- Server / storage
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=resume_screening.db
UPLOAD_DIR=uploads
